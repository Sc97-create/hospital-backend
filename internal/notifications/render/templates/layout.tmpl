{{define "layout"}}
<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{.HospitalName}}</title>
  </head>
  <body style="margin:0; padding:0; background-color:#eef2f5; font-family:Arial, Helvetica, sans-serif;">
    <table width="100%" cellpadding="0" cellspacing="0" role="presentation" style="background-color:#eef2f5;">
      <tr>
        <td align="center" style="padding:32px 16px;">
          <table width="600" cellpadding="0" cellspacing="0" role="presentation" align="center" style="width:600px; max-width:600px; background-color:#ffffff; border:1px solid #e4e7eb; border-radius:10px;">
            <tr>
              <td style="padding:22px 28px 18px 28px; background-color:#1f3a4d;">
                <p style="margin:0 0 6px 0; color:#9fd3c7; font-size:11px; letter-spacing:1.4px; font-weight:bold;">
                  FLOATOHEALTH
                </p>
                <h1 style="margin:0; color:#ffffff; font-size:22px; line-height:1.3; font-weight:bold;">
                  {{if .HospitalName}}{{.HospitalName}}{{else}}Floatohealth{{end}}
                </h1>
              </td>
            </tr>
            <tr>
              <td style="padding:28px 28px 8px 28px; color:#243140; font-size:15px; line-height:1.6;">
                {{template "content" .}}
              </td>
            </tr>
            <tr>
              <td style="padding:8px 28px 24px 28px;">
                <p style="margin:16px 0 0 0; padding-top:16px; border-top:1px solid #e6eaee; color:#5c6b7a; font-size:13px; line-height:1.6;">
                  {{if .HospitalName}}{{.HospitalName}}<br>{{end}}
                  Sent by <span style="color:#1f3a4d; font-weight:bold;">Floatohealth</span><br>
                  <a href="mailto:support@floatohealth.com" style="color:#1f6f78; text-decoration:none;">support@floatohealth.com</a>
                </p>
              </td>
            </tr>
          </table>
          <p style="margin:14px 0 0 0; max-width:600px; color:#8b97a3; font-size:12px; line-height:1.5;">
            Floatohealth sends this message for your clinic. Please contact the clinic if any detail looks incorrect.
          </p>
        </td>
      </tr>
    </table>
  </body>
</html>
{{end}}
