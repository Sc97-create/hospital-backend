{{define "content"}}
<p style="margin:0 0 16px 0;">Dear {{.PatientName}},</p>

<p style="margin:0 0 20px 0;">
  Your payment was received successfully.
</p>

<table width="100%" cellpadding="0" cellspacing="0" role="presentation"
  style="background-color:#f9fafb; border-radius:6px; border:1px solid #eef0f2;">
  <tr>
    <td style="padding:14px 16px; color:#666666; font-size:13px;">
      Amount Paid
    </td>
    <td style="padding:14px 16px; color:#2c3e50; font-size:14px; font-weight:bold;">
      {{.Currency}} {{.Amount}}
    </td>
  </tr>
  <tr>
    <td style="padding:14px 16px; color:#666666; font-size:13px;">
      Payment Status
    </td>
    <td style="padding:14px 16px; color:#2c3e50; font-size:14px; font-weight:bold;">
      {{.PaymentStatus}}
    </td>
  </tr>
  <tr>
    <td style="padding:14px 16px; color:#666666; font-size:13px;">
      Paid At
    </td>
    <td style="padding:14px 16px; color:#2c3e50; font-size:14px; font-weight:bold;">
      {{.PaidAt}}
    </td>
  </tr>
</table>

<p style="margin:20px 0 0 0; color:#666666; font-size:14px;">
  Thank you for your payment.
</p>
{{end}}