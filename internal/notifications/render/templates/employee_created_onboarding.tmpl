{{define "content"}}
<p style="margin:0 0 16px 0;">Dear {{.EmployeeName}},</p>

<p style="margin:0 0 20px 0;">
  Your employee profile has been created at <strong>{{.HospitalName}}</strong>. Please keep these details for your records.
</p>

<table width="100%" cellpadding="0" cellspacing="0" role="presentation" style="background-color:#f9fafb; border-radius:6px; border:1px solid #eef0f2;">
  <tr>
    <td style="padding:14px 16px; border-bottom:1px solid #eef0f2; color:#666666; font-size:13px; width:40%;">Employee Code</td>
    <td style="padding:14px 16px; border-bottom:1px solid #eef0f2; color:#2c3e50; font-size:14px; font-weight:bold; letter-spacing:1px;">{{.EmployeeCode}}</td>
  </tr>
  <tr>
    <td style="padding:14px 16px; border-bottom:1px solid #eef0f2; color:#666666; font-size:13px;">Role</td>
    <td style="padding:14px 16px; border-bottom:1px solid #eef0f2; color:#2c3e50; font-size:14px; font-weight:bold;">{{.RoleName}}</td>
  </tr>
  <tr>
    <td style="padding:14px 16px; border-bottom:1px solid #eef0f2; color:#666666; font-size:13px;">Department</td>
    <td style="padding:14px 16px; border-bottom:1px solid #eef0f2; color:#2c3e50; font-size:14px; font-weight:bold;">{{.DepartmentName}}</td>
  </tr>
  <tr>
    <td style="padding:14px 16px; border-bottom:1px solid #eef0f2; color:#666666; font-size:13px;">Employee Type</td>
    <td style="padding:14px 16px; border-bottom:1px solid #eef0f2; color:#2c3e50; font-size:14px; font-weight:bold;">{{.EmployeeType}}</td>
  </tr>
  <tr>
    <td style="padding:14px 16px; border-bottom:1px solid #eef0f2; color:#666666; font-size:13px;">Official Email</td>
    <td style="padding:14px 16px; border-bottom:1px solid #eef0f2; color:#2c3e50; font-size:14px; font-weight:bold;">{{.EmployeeEmail}}</td>
  </tr>
  <tr>
    <td style="padding:14px 16px; border-bottom:1px solid #eef0f2; color:#666666; font-size:13px;">Date of Joining</td>
    <td style="padding:14px 16px; border-bottom:1px solid #eef0f2; color:#2c3e50; font-size:14px; font-weight:bold;">{{.DateOfJoining}}</td>
  </tr>
  <tr>
    <td style="padding:14px 16px; color:#666666; font-size:13px;">Shift</td>
    <td style="padding:14px 16px; color:#2c3e50; font-size:14px; font-weight:bold;">{{.ShiftStartTime}} – {{.ShiftEndTime}}</td>
  </tr>
</table>

<p style="margin:24px 0 0 0;">
  <a href="{{.LoginURL}}" style="display:inline-block; background-color:#2c3e50; color:#ffffff; padding:12px 22px; text-decoration:none; border-radius:6px; font-size:14px; font-weight:bold;">
    Go to Login
  </a>
</p>
{{end}}
