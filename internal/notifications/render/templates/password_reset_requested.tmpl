{{define "content"}}
<p style="margin:0 0 16px 0;">Dear {{.EmployeeName}},</p>

<p style="margin:0 0 20px 0;">
  We received a request to reset the password for your account
  (<strong>{{.EmployeeEmail}}</strong>).
</p>

<p style="margin:0 0 24px 0;">
  Use the button below to choose a new password. This link is valid for a limited time.
  If you did not request a reset, you can ignore this email.
</p>

<p style="margin:0 0 24px 0;">
  <a href="{{.ResetURL}}" style="display:inline-block; background-color:#2c3e50; color:#ffffff; padding:12px 22px; text-decoration:none; border-radius:6px; font-size:14px; font-weight:bold;">
    Reset password
  </a>
</p>

<p style="margin:0 0 12px 0; color:#666666; font-size:13px;">
  Or copy and paste this link into your browser:
</p>
<p style="margin:0 0 24px 0; word-break:break-all; color:#2c3e50; font-size:13px;">
  {{.ResetURL}}
</p>

<p style="margin:0; color:#666666; font-size:14px;">
  For security, you can request another reset link only after {{.CooldownMinutes}} minutes.
</p>
{{end}}
