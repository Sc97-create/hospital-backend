{{define "content"}}
<p style="margin:0 0 16px 0;">Dear {{.EmployeeName}},</p>

<p style="margin:0 0 20px 0;">
  Welcome to <strong>{{.HospitalName}}</strong>. Your staff account is ready.
  You have been added as <strong>{{.RoleName}}</strong> in <strong>{{.DepartmentName}}</strong>.
</p>

<table width="100%" cellpadding="0" cellspacing="0" role="presentation" style="background-color:#f9fafb; border-radius:6px; border:1px solid #eef0f2; margin-bottom:24px;">
  <tr>
    <td style="padding:14px 16px; border-bottom:1px solid #eef0f2; color:#666666; font-size:13px; width:40%;">Email</td>
    <td style="padding:14px 16px; border-bottom:1px solid #eef0f2; color:#2c3e50; font-size:14px; font-weight:bold;">{{.EmployeeEmail}}</td>
  </tr>
  <tr>
    <td style="padding:14px 16px; color:#666666; font-size:13px;">Temporary password</td>
    <td style="padding:14px 16px; color:#2c3e50; font-size:14px; font-weight:bold;">{{.TempPassword}}</td>
  </tr>
</table>

<p style="margin:0 0 24px 0;">
  Use the button below to sign in with your official email. Please change this password after you sign in.
</p>

<p style="margin:0 0 24px 0;">
  <a href="{{.LoginURL}}" style="display:inline-block; background-color:#2c3e50; color:#ffffff; padding:12px 22px; text-decoration:none; border-radius:6px; font-size:14px; font-weight:bold;">
    Go to Login
  </a>
</p>

<p style="margin:0; color:#666666; font-size:14px;">
  If you were not expecting this account, you can ignore this email.
</p>
{{end}}
