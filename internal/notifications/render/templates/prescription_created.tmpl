{{define "content"}}
<p style="margin:0 0 16px 0;">Dear {{.PatientName}},</p>

<p style="margin:0 0 20px 0;">
  Your consultation has been completed and your prescription has been generated. Please find the details below.
</p>

<table width="100%" cellpadding="0" cellspacing="0" role="presentation" style="background-color:#f9fafb; border-radius:6px; border:1px solid #eef0f2; margin-bottom:24px;">
  <tr>
    <td style="padding:14px 16px; border-bottom:1px solid #eef0f2; color:#666666; font-size:13px; width:40%;">
      Prescription Code
    </td>
    <td style="padding:14px 16px; border-bottom:1px solid #eef0f2; color:#2c3e50; font-size:14px; font-weight:bold;">
      {{.PrescriptionCode}}
    </td>
  </tr>
  <tr>
    <td style="padding:14px 16px; border-bottom:1px solid #eef0f2; color:#666666; font-size:13px;">
      Consultation Date
    </td>
    <td style="padding:14px 16px; border-bottom:1px solid #eef0f2; color:#2c3e50; font-size:14px; font-weight:bold;">
      {{.ConsultedOn}}
    </td>
  </tr>
  <tr>
    <td style="padding:14px 16px; border-bottom:1px solid #eef0f2; color:#666666; font-size:13px;">
      Doctor
    </td>
    <td style="padding:14px 16px; border-bottom:1px solid #eef0f2; color:#2c3e50; font-size:14px; font-weight:bold;">
      Dr. {{.DoctorName}}
    </td>
  </tr>
  <tr>
    <td style="padding:14px 16px; color:#666666; font-size:13px;">
      Hospital
    </td>
    <td style="padding:14px 16px; color:#2c3e50; font-size:14px; font-weight:bold;">
      {{.HospitalName}}
    </td>
  </tr>
</table>

<p style="margin:0 0 12px 0; color:#2c3e50; font-size:15px; font-weight:bold;">
  Prescribed Medicines
</p>

<table width="100%" cellpadding="0" cellspacing="0" role="presentation" style="border:1px solid #eef0f2; border-radius:6px; overflow:hidden;">
  <tr style="background-color:#2c3e50;">
    <td style="padding:12px 10px; color:#ffffff; font-size:12px; font-weight:bold;">Medicine</td>
    <td style="padding:12px 10px; color:#ffffff; font-size:12px; font-weight:bold;">Form / Strength</td>
    <td style="padding:12px 10px; color:#ffffff; font-size:12px; font-weight:bold;">Dosage</td>
    <td style="padding:12px 10px; color:#ffffff; font-size:12px; font-weight:bold;">Duration</td>
    <td style="padding:12px 10px; color:#ffffff; font-size:12px; font-weight:bold;">Qty</td>
    <td style="padding:12px 10px; color:#ffffff; font-size:12px; font-weight:bold;">Instructions</td>
  </tr>
  {{range .Medicines}}
  <tr style="background-color:#ffffff;">
    <td style="padding:12px 10px; border-top:1px solid #eef0f2; color:#2c3e50; font-size:13px; font-weight:bold;">
      {{.Name}}
    </td>
    <td style="padding:12px 10px; border-top:1px solid #eef0f2; color:#555555; font-size:13px;">
      {{.Form}}{{if .Strength}} / {{.Strength}}{{end}}
    </td>
    <td style="padding:12px 10px; border-top:1px solid #eef0f2; color:#555555; font-size:13px;">
      {{.Dosage}}
    </td>
    <td style="padding:12px 10px; border-top:1px solid #eef0f2; color:#555555; font-size:13px;">
      {{.Duration}}
    </td>
    <td style="padding:12px 10px; border-top:1px solid #eef0f2; color:#555555; font-size:13px;">
      {{.Quantity}}
    </td>
    <td style="padding:12px 10px; border-top:1px solid #eef0f2; color:#555555; font-size:13px;">
      {{.FoodInstruction}}
    </td>
  </tr>
  {{else}}
  <tr>
    <td colspan="6" style="padding:14px 10px; border-top:1px solid #eef0f2; color:#888888; font-size:13px; text-align:center;">
      No medicines listed on this prescription.
    </td>
  </tr>
  {{end}}
</table>

{{if .PrescriptionSummary}}
<p style="margin:20px 0 8px 0; color:#2c3e50; font-size:15px; font-weight:bold;">
  Additional Notes
</p>
<p style="margin:0 0 20px 0; color:#555555; font-size:14px; line-height:1.6; background-color:#f9fafb; border-radius:6px; padding:14px 16px; border:1px solid #eef0f2;">
  {{.PrescriptionSummary}}
</p>
{{end}}

<p style="margin:20px 0 0 0; color:#666666; font-size:14px;">
  Please follow the prescribed medication schedule and contact the hospital if you have any questions.
</p>
{{end}}
